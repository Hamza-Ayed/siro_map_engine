{
	"version": 8,
	"name": "Siro translucent",
	"center": [35.9106, 31.9539],
	"zoom": 8,
	"sources": {
		"siro-lines": {
			"type": "vector",
			"tiles": ["https://tiles.intaleqapp.com/planet_osm_line/{z}/{x}/{y}"],
			"maxzoom": 14,
			"attribution": "© OpenStreetMap contributors · Siro Maps"
		}
	},
	"glyphs": "https://map-saas.intaleqapp.com/fonts/{fontstack}/{range}.pbf",
	"layers": [
		{
			"id": "background",
			"type": "background",
			"paint": {
				"background-color": "#ffffff",
				"background-opacity": 0
			}
		},
		{
			"id": "boundaries",
			"type": "line",
			"source": "siro-lines",
			"source-layer": "planet_osm_line",
			"filter": ["all", ["==", "boundary", "administrative"], ["in", "admin_level", "2", "4"]],
			"paint": {
				"line-color": "#000000",
				"line-width": 1.5
			}
		},
		{
			"id": "main-roads",
			"type": "line",
			"source": "siro-lines",
			"source-layer": "planet_osm_line",
			"minzoom": 6,
			"filter": ["in", "highway", "motorway", "trunk", "primary"],
			"paint": {
				"line-color": "#ffffff",
				"line-width": 1.2
			}
		}
	]
}
